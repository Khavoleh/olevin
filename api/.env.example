# API Key to receive exchange rate data
ExchangeRate__ApiKey=ExchangeRate__ApiKey # Example: a1b2c3d4e5f6a7b8c9d0e1f2

# Signing key of the Logto webhook that reports a deleted user
Logto__WebhookSigningKey=Logto__WebhookSigningKey # Example: NXudmFCGLx1ocjNYG2IchR84zeTJV7fc

# DSN of the GlitchTip project of the API
Sentry__Dsn=Sentry__Dsn # Example: https://4f1c2a8e9b7d4e6f8a1b2c3d4e5f6a7b@glitchtip.localhost:8443/1

# VAPID key pair the Web Push messages are signed with (base64url)
WebPush__PublicKey=WebPush__PublicKey # Example: BH0Ulm1Lh1kYXqGV3yMAOcho5OPliSjyxHuY42XyEnBELkQ-o_JSvLed2KfTD0T59Py6w6gQuLSPGfzKDi_ISXM
WebPush__PrivateKey=WebPush__PrivateKey # Example: 3K1Wq9v8zXf0Jm2bT7cR4yNpHs6uLa5dEgOiVkYwQx0
