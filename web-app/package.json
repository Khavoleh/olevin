{
	"name": "olevin-web-app",
	"version": "0.0.1",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/Khavoleh/olevin"
	},
	"scripts": {
		"dev": "echo \"Available at https://app.localhost (via Caddy)\" && NODE_USE_SYSTEM_CA=1 next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"prettier": "prettier \"**/*.{md,yml,yaml}\" --write",
		"prettier:check": "prettier \"**/*.{md,yml,yaml}\" --check",
		"check-types": "tsc --noEmit",
		"unit": "vitest run",
		"depcruise": "depcruise src",
		"validate": "pnpm build && pnpm unit && pnpm lint && pnpm prettier:check && pnpm check-types && pnpm depcruise"
	},
	"dependencies": {
		"@logto/next": "5.0.0",
		"@tanstack/react-query": "5.104.1",
		"next": "16.3.8",
		"react": "19.3.0",
		"react-aria-components": "1.21.1",
		"react-dom": "19.3.0",
		"zod": "4.6.5",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@tailwindcss/postcss": "4.3.3",
		"@types/node": "24.19.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"dependency-cruiser": "18.5.0",
		"prettier": "3.9.9",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vitest": "5.0.3"
	}
}
