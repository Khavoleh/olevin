# Public URL of the app
APP_BASE_URL=APP_BASE_URL # Example: https://app.localhost

# Logto "Traditional web" application
LOGTO_ENDPOINT=LOGTO_ENDPOINT # Example: https://localhost:3001
LOGTO_APP_ID=LOGTO_APP_ID # Example: tanpk2kl7j6aybogjvnk8
LOGTO_APP_SECRET=LOGTO_APP_SECRET # Example: hH13kY70QFCthdIwRs2CSXvVpEkiOL1A
LOGTO_COOKIE_SECRET=LOGTO_COOKIE_SECRET # Example: NXudmFCGLx1ocjNYG2IchR84zeTJV7fc
LOGTO_API_RESOURCE=LOGTO_API_RESOURCE # Example: https://api.localhost

# Logto "Machine-to-machine" application with access to the Management API
LOGTO_M2M_APP_ID=LOGTO_M2M_APP_ID # Example: 8x2kq7m5v1n3bz0wcyrt4
LOGTO_M2M_APP_SECRET=LOGTO_M2M_APP_SECRET # Example: Zp4QeW9sT2uYhN6vKc1LdRb8XfA3gJmO

# Address of the API
API_URL=API_URL # Example: https://api.localhost

# DSN of the GlitchTip project of the web app
NEXT_PUBLIC_SENTRY_DSN=NEXT_PUBLIC_SENTRY_DSN # Example: https://9a8b7c6d5e4f4a3b2c1d0e9f8a7b6c5d@glitchtip.localhost/2

# Public VAPID key of the API that browsers subscribe to the push with
VAPID_PUBLIC_KEY=VAPID_PUBLIC_KEY # Example: BH0Ulm1Lh1kYXqGV3yMAOcho5OPliSjyxHuY42XyEnBELkQ-o_JSvLed2KfTD0T59Py6w6gQuLSPGfzKDi_ISXM
