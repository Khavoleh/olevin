# Public URL of the app
APP_BASE_URL=APP_BASE_URL # Example: https://app.localhost

# Logto "Traditional web" application
LOGTO_ENDPOINT=LOGTO_ENDPOINT # Example: https://localhost:3001
LOGTO_APP_ID=LOGTO_APP_ID # Example: tanpk2kl7j6aybogjvnk8
LOGTO_APP_SECRET=LOGTO_APP_SECRET # Example: hH13kY70QFCthdIwRs2CSXvVpEkiOL1A
